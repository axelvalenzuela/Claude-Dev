# Ejecutar con una identidad con: Folder Admin, Organization Policy Administrator, Tag Admin,
# Compute Organization Firewall Policy Admin, Project Creator y Billing Account User.
project_id        = "mi-proyecto-labs"   # proyecto "host" para cuotas/facturación de las APIs
region            = "us-central1"
environment       = "dev"
owner             = "axel"
org_id            = "123456789012"
parent_folder_id  = "987654321098"       # carpeta sandbox (recomendado)
billing_account   = "XXXXXX-XXXXXX-XXXXXX"
environments      = ["dev", "prod"]
allowed_locations = ["in:us-locations"]
project_suffix    = "av26"
projects = {
  "ventas-dev"  = { environment = "dev", extra_services = ["run.googleapis.com"] }
  "ventas-prod" = { environment = "prod", extra_services = ["run.googleapis.com"], monthly_budget = 50 }
}
