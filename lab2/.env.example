# Copy this file to .env and adjust values for your machine.
# .env is gitignored — never commit real secrets.

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=True

# --- Production/container-only settings (see docs/DEPLOYMENT.md) --------
# Uncomment and set these when deploying, e.g. via docker-compose.yml.
# DJANGO_ALLOWED_HOSTS=expenses.intranet.mhp.local
# DJANGO_CSRF_TRUSTED_ORIGINS=https://expenses.intranet.mhp.local
# DJANGO_HTTPS_ENABLED=True
# DATABASE_URL=sqlite:////data/db.sqlite3
# DJANGO_MEDIA_ROOT=/data/media

# `python manage.py runserver` stops itself after this many hours, so a
# forgotten local server doesn't run forever. Set to 0 to disable.
AUTO_SHUTDOWN_HOURS=12

# Bootstrap admin, seeded on first `python manage.py migrate` — a generic
# dev-access account, separate from the two named org-chart admins below.
ADMIN_SEED_EMAIL=axel.valenzuela@uabc.edu.mx
ADMIN_SEED_PASSWORD=Admin#2026Local
ADMIN_SEED_NAME=Axel Valenzuela
ADMIN_SEED_DEPARTMENT=ICS

# General/HR admin — approves every department's reports (is_superuser).
HR_ADMIN_EMAIL=iris.cortez@mhp.com
HR_ADMIN_PASSWORD=Iris#2026Local
HR_ADMIN_NAME=Iris Cortez
HR_ADMIN_DEPARTMENT=Human Resources

# ICS department admin — only sees/approves reports from ICS employees.
ICS_ADMIN_EMAIL=adrian.heymes@mhp.com
ICS_ADMIN_PASSWORD=Adrian#2026Local
ICS_ADMIN_NAME=Adrian Heymes
ICS_ADMIN_DEPARTMENT=ICS

# Password-reset emails print to the console by default (no SMTP needed
# locally). Point this at a real backend (e.g. smtp.EmailBackend) to
# actually send them, and set the SMTP_* variables Django's backend expects.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@mhp.local
