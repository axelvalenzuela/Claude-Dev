# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is read only for LOCAL development (src/config.py, via python-dotenv).
# On Cloud Run these are set with `--set-env-vars` instead (see INSTRUCCIONES.md)
# and no .env file is deployed — it's in .gitignore on purpose.

# Your GCP project id (not the project *name* or *number*).
# Find it with: gcloud config get-value project
GCP_PROJECT_ID=tu-proyecto-gcp

# Vertex AI region. us-central1 has the widest model availability.
GCP_LOCATION=us-central1

# Vertex AI model ids. Check the current names for your project/region in
# Vertex AI Model Garden before relying on these — model ids change over
# time and older ones get retired.
EMBEDDING_MODEL=text-embedding-005
GENERATION_MODEL=gemini-2.5-flash

# How many chunks of context to retrieve per question (see CONCEPTOS.md).
RAG_TOP_K=4

# Local port for `uvicorn src.main:app`. Cloud Run overrides this with its
# own PORT env var automatically — src/main.py respects that too.
PORT=8080
