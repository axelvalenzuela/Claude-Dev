# Copia este archivo a .env y edítalo:   cp .env.example .env
# .env está en .gitignore: NUNCA lo subas a git.

# simulado = todo corre local y gratis (respuestas falsas).
# real     = llama a Vertex AI y cobra a tu proyecto. Ver docs/CONECTAR_GCP.md
MODO=simulado

# El ID del proyecto (no el nombre ni el número): gcloud config get-value project
GCP_PROJECT_ID=tu-proyecto-gcp

# Región para BigQuery, Cloud Run, Cloud Functions, Storage.
GCP_REGION=us-central1

# Los modelos Gemini 3.x se sirven desde el endpoint "global".
# Si un modelo te da 404 "not found", prueba con us-central1 (y viceversa).
GCP_REGION_MODELOS=global
GCP_REGION_EMBEDDINGS=us-central1

# Modelos (sept. 2026). Los IDs cambian y los viejos se retiran: confírmalos en
# Vertex AI > Model Garden. flash-lite es el más barato; para convertir código
# con mejor calidad prueba gemini-3.8-flash o gemini-3.1-pro.
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Recursos que crea infra/ (Terraform). Si los dejas vacíos se usan estos nombres.
# GCS_BUCKET=tu-proyecto-gcp-migracion-sas
BQ_DATASET=migracion_sas

# WARNING (por defecto) o INFO para ver cada llamada como log JSON.
LOG_NIVEL=WARNING
