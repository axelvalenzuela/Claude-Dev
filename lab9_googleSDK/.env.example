# Copia este archivo como .env (no se sube a git) y llena UNA de las dos opciones.

# --- Opcion A: Gemini Developer API (API key de https://aistudio.google.com/apikey) ---
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=pon_tu_api_key_aqui

# --- Opcion B: Vertex AI (requiere: gcloud auth application-default login) ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
# GOOGLE_CLOUD_LOCATION=us-central1

# Modelos (opcional)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
